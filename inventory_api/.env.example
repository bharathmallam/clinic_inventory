# Local development only: copy to .env and fill in.
# On the Lightsail server these settings live in /etc/ultrahealth/inventory.env,
# which deploy/lightsail/install.sh creates (with a generated SECRET_KEY and
# database password) — there is no .env on the server.

# development = your own computer (allows the simple test logins); production = the live site
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# Local MySQL:
# DATABASE_URL=mysql+pymysql://inventory:PASSWORD@127.0.0.1:3306/inventory?charset=utf8mb4
# Leave DATABASE_URL unset to use a local SQLite file instead.
JWT_EXPIRY_HOURS=24
